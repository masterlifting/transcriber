<Window x:Class="LocalTranscriber.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Local Transcriber"
        Width="880" Height="720" MinWidth="800" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        Closing="OnClosing">

    <Window.Resources>
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>
        <Style x:Key="RowActionIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Local Transcriber" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="Record and transcribe calls" FontSize="13"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" VerticalAlignment="Center"
                        Padding="14,6" ToolTip="Refresh devices and calls">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ Status card ============ -->
        <materialDesign:Card Grid.Row="1" Margin="0,20,0,0" Padding="0"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Stage accent bar -->
                <Border Grid.Column="0" CornerRadius="3,0,0,3" Width="8" HorizontalAlignment="Left">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Stage}" Value="Completed">
                                    <Setter Property="Background" Value="#1E8E3E"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Stage}" Value="Failed">
                                    <Setter Property="Background" Value="#C62828"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Stage icon -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,14,14,14">
                    <materialDesign:PackIcon Width="30" Height="30" VerticalAlignment="Center">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="Microphone"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Stage}" Value="Recording">
                                        <Setter Property="Kind" Value="RecordCircle"/>
                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Stopping">
                                        <Setter Property="Kind" Value="StopCircle"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Transcribing">
                                        <Setter Property="Kind" Value="Autorenew"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Completed">
                                        <Setter Property="Kind" Value="CheckCircle"/>
                                        <Setter Property="Foreground" Value="#1E8E3E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Failed">
                                        <Setter Property="Kind" Value="AlertCircle"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </StackPanel>

                <!-- Stage text -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,14,18,14">
                    <TextBlock Text="{Binding StageText}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ElapsedText}" FontSize="34" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,4,0,0"
                               Visibility="{Binding TimerVisible, Converter={StaticResource BoolToVis}}"/>
                    <ProgressBar Height="6" IsIndeterminate="True"
                                 Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}"
                                 Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding ResultDetail}" FontSize="12" Foreground="#B00020"
                               TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="88"
                               Visibility="{Binding ResultActionsVisible, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- ============ Selectors ============ -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Application -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="APPLICATION" Style="{StaticResource CaptionText}"/>
                <ComboBox ItemsSource="{Binding Applications}"
                          SelectedItem="{Binding SelectedApplication}" DisplayMemberPath="Name"
                          IsEnabled="{Binding SelectorsEnabled}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                <StackPanel Orientation="Horizontal" Margin="4,6,0,0">
                    <Ellipse Width="8" Height="8" Fill="{Binding TargetStatusBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding TargetStatusText}" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Microphone -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="MICROPHONE" Style="{StaticResource CaptionText}"/>
                <ComboBox ItemsSource="{Binding Microphones}"
                          SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding SelectorsEnabled}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
            </StackPanel>
        </Grid>

        <!-- ============ Start / Stop ============ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,22,0,0"
                    Visibility="{Binding StartStopPanelVisible, Converter={StaticResource BoolToVis}}">
            <Button Command="{Binding StartCommand}" Margin="0,0,16,0" IsEnabled="{Binding StartEnabled}"
                    MinWidth="150" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                <Setter Property="Background" Value="#E3E3E3"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Play" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Start Recording" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding StopCommand}" IsEnabled="{Binding StopEnabled}"
                    MinWidth="150" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#D32F2F"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                <Setter Property="Background" Value="#E3E3E3"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Stop" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Stop Recording" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ============ Result actions ============ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,22,0,0"
                    Visibility="{Binding ResultActionsVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="Duration:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <TextBlock Text="{Binding ResultDuration}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="Application:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <TextBlock Text="{Binding ResultApplication}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Command="{Binding OpenTranscriptCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="14,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileDocument" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Open Transcript" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding CopyTranscriptCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="14,8" Margin="0,0,10,0" IsEnabled="{Binding CanCopyTranscript}"
                    ToolTip="Copy transcript">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Copy" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenFolderCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="14,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Folder" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Open Folder" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding RetryTranscriptionCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="14,8" Margin="0,0,10,0"
                    Visibility="{Binding RetryVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Retry Transcription" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding RecordAnotherCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                    Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Record Another" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ============ Recent Calls ============ -->
        <Grid Grid.Row="4" Margin="0,22,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Section header: title + calls folder + change -->
            <Grid Grid.Row="0" Margin="2,0,2,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Recent Calls" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <materialDesign:PackIcon Kind="Folder" Width="15" Height="15"
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding CallsFolderDisplay}" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="340"/>
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding ChangeCallsFolderCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Padding="10,5"
                        ToolTip="Choose where call recordings are stored">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderMove" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Change" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Column headers -->
            <Grid Grid.Row="1" Margin="14,0,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TIME" Style="{StaticResource CaptionText}"/>
                <TextBlock Grid.Column="1" Text="APPLICATION" Style="{StaticResource CaptionText}"/>
                <TextBlock Grid.Column="2" Text="DURATION" Style="{StaticResource CaptionText}"/>
                <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource CaptionText}"/>
                <TextBlock Grid.Column="4" Text="ACTIONS" Style="{StaticResource CaptionText}" Margin="2,0,0,4"/>
                <TextBlock Grid.Column="3" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding CopyFeedback}" FontSize="13" FontWeight="SemiBold" Foreground="#1E8E3E"
                           Visibility="{Binding CopyFeedbackVisible, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <materialDesign:Card Grid.Row="2" Padding="8" materialDesign:ElevationAssist.Elevation="Dp1">
                <ListView ItemsSource="{Binding RecentCalls}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          BorderThickness="0" Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="6,4"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProcessName}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding DurationLabel}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>

                                <!-- status chip -->
                                <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{Binding StatusBackground}" CornerRadius="10"
                                        Padding="10,3" Margin="0,0,0,0">
                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding StatusBrush}"/>
                                </Border>

                                <!-- actions -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Transcript" Padding="10,4"
                                            Style="{StaticResource MaterialDesignFlatButton}" MinWidth="0"
                                            Command="{Binding DataContext.OpenTranscriptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Folder" Padding="10,4" Margin="2,0,0,0"
                                            Style="{StaticResource MaterialDesignFlatButton}" MinWidth="0"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource RowActionIconButton}" ToolTip="Copy transcript"
                                            Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.CopyTranscriptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource RowActionIconButton}" ToolTip="Retry transcription"
                                            Visibility="{Binding RetryVisible, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RetryTranscriptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource RowActionIconButton}" ToolTip="Delete call"
                                            Command="{Binding DataContext.DeleteCallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
